---
import Layout from '../layouts/Layout.astro';
const catalogo = await Astro.glob('../catalogo/*.md');
---

<Layout title="Catálogo - Alma de Porcelana">
	<main class="max-w-6xl mx-auto p-4 py-8">
		<h1 class="text-4xl font-bold text-center text-rose-600 mb-8 font-serif">Catálogo de Productos</h1>

		{/* Sección de Insumos */}
		<h2 class="text-2xl font-semibold text-gray-800 mb-4 border-b-2 border-rose-200 pb-2">Insumos</h2>
		<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mb-12">
			{catalogo.filter(producto => producto.frontmatter.categoria === 'Insumo').map((producto) => (
				<div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
					<img src={producto.frontmatter.image} alt={producto.frontmatter.title} class="w-full h-48 object-cover" />
					<div class="p-4">
						<h3 class="text-lg font-bold text-gray-800 mb-2">{producto.frontmatter.title}</h3>
						<p class="text-sm text-gray-600 mb-3 line-clamp-2">{producto.frontmatter.descripcion}</p>
						<div class="flex justify-between items-center">
							<span class="text-sm font-medium px-2 py-1 bg-rose-100 text-rose-700 rounded-full">{producto.frontmatter.stock}</span>
							<span class="font-bold text-gray-900">Consultar</span>
						</div>
					</div>
				</div>
			))}
		</div>

		{/* Sección de Piezas Terminadas */}
		<h2 class="text-2xl font-semibold text-gray-800 mb-4 border-b-2 border-rose-200 pb-2">Piezas Terminadas</h2>
		<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
			{catalogo.filter(producto => producto.frontmatter.categoria === 'Pieza Terminada').map((producto) => (
				<div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
					<img src={producto.frontmatter.image} alt={producto.frontmatter.title} class="w-full h-48 object-cover" />
					<div class="p-4">
						<h3 class="text-lg font-bold text-gray-800 mb-2">{producto.frontmatter.title}</h3>
						<p class="text-sm text-gray-600 mb-3 line-clamp-2">{producto.frontmatter.descripcion}</p>
						<div class="flex justify-between items-center">
							<span class="text-sm font-medium px-2 py-1 bg-rose-100 text-rose-700 rounded-full">{producto.frontmatter.stock}</span>
							<span class="font-bold text-gray-900">Consultar</span>
						</div>
					</div>
				</div>
			))}
		</div>
	</main>
</Layout>