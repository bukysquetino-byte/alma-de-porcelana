---
import Layout from '../layouts/Layout.astro';
const catalogoArchivos = import.meta.glob('../catalogo/*.md', { eager: true });
const catalogo = Object.values(catalogoArchivos);
---

<Layout title="Catálogo - Alma de Porcelana">
	<main class="max-w-6xl mx-auto p-4 py-12">
		<h1 class="text-4xl font-bold text-center text-rose-600 mb-12 font-serif">Catálogo de Productos</h1>

		{/* Sección de Insumos */}
		<h2 class="text-2xl font-semibold text-gray-800 mb-6 border-b-2 border-rose-200 pb-2">Insumos</h2>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 mb-16">
			{catalogo.filter((producto: any) => producto.frontmatter?.categoria === 'Insumo').map((producto: any) => (
				<div class="bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-lg transition-all duration-300 flex flex-col h-full">
					{/* Contenedor de la imagen con proporción cuadrada perfecta */}
					<div class="aspect-square w-full overflow-hidden bg-gray-50 rounded-t-xl p-4 flex items-center justify-center">
						<img 
							src={producto.frontmatter?.image} 
							alt={producto.frontmatter?.title} 
							class="w-full h-full object-contain mix-blend-multiply" 
						/>
					</div>
					{/* Contenedor del texto que se expande para empujar los botones abajo */}
					<div class="p-5 flex flex-col flex-grow">
						<h3 class="text-lg font-bold text-gray-800 mb-2 leading-tight">{producto.frontmatter?.title}</h3>
						<p class="text-sm text-gray-600 mb-4 flex-grow">{producto.frontmatter?.descripcion}</p>
						
						<div class="flex justify-between items-center mt-auto pt-4 border-t border-gray-100">
							<span class="text-xs font-semibold px-3 py-1 bg-rose-50 text-rose-600 rounded-full">{producto.frontmatter?.stock}</span>
							<a href="https://wa.me/5492942404971?text=Hola!%20Quisiera%20consultar%20el%20precio%20del%20producto:%20" class="text-sm font-bold text-white bg-rose-500 hover:bg-rose-600 px-4 py-2 rounded-lg transition-colors">Consultar</a>
						</div>
					</div>
				</div>
			))}
		</div>

		{/* Sección de Piezas Terminadas */}
		<h2 class="text-2xl font-semibold text-gray-800 mb-6 border-b-2 border-rose-200 pb-2">Piezas Terminadas</h2>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
			{catalogo.filter((producto: any) => producto.frontmatter?.categoria === 'Pieza Terminada').map((producto: any) => (
				<div class="bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-lg transition-all duration-300 flex flex-col h-full">
					<div class="aspect-square w-full overflow-hidden bg-gray-50 rounded-t-xl p-4 flex items-center justify-center">
						<img 
							src={producto.frontmatter?.image} 
							alt={producto.frontmatter?.title} 
							class="w-full h-full object-contain mix-blend-multiply" 
						/>
					</div>
					<div class="p-5 flex flex-col flex-grow">
						<h3 class="text-lg font-bold text-gray-800 mb-2 leading-tight">{producto.frontmatter?.title}</h3>
						<p class="text-sm text-gray-600 mb-4 flex-grow">{producto.frontmatter?.descripcion}</p>
						
						<div class="flex justify-between items-center mt-auto pt-4 border-t border-gray-100">
							<span class="text-xs font-semibold px-3 py-1 bg-rose-50 text-rose-600 rounded-full">{producto.frontmatter?.stock}</span>
							<a href="https://wa.me/5492942404971?text=Hola!%20Quisiera%20consultar%20el%20precio%20del%20producto:%20" class="text-sm font-bold text-white bg-rose-500 hover:bg-rose-600 px-4 py-2 rounded-lg transition-colors">Consultar</a>
						</div>
					</div>
				</div>
			))}
		</div>
	</main>
</Layout>