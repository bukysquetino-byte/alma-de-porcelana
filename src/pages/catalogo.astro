---
import Layout from '../layouts/Layout.astro';
const catalogoArchivos = import.meta.glob('../catalogo/*.md', { eager: true });
const catalogo = Object.values(catalogoArchivos);
---

<Layout title="Catálogo - Alma de Porcelana">
	<main class="contenedor-catalogo">
		<h1 class="titulo-catalogo">Catálogo de Productos</h1>

		{/* Sección de Insumos */}
		<h2 class="subtitulo-catalogo">Insumos</h2>
		<div class="grilla-productos">
			{catalogo.filter((producto: any) => producto.frontmatter?.categoria === 'Insumo').map((producto: any) => (
				<div class="tarjeta-producto">
					<div class="contenedor-imagen">
						<img src={producto.frontmatter?.image} alt={producto.frontmatter?.title} />
					</div>
					<div class="contenido-producto">
						<h3>{producto.frontmatter?.title}</h3>
						<p>{producto.frontmatter?.descripcion}</p>
						
						<div class="acciones-producto">
							<span class="etiqueta-stock">{producto.frontmatter?.stock}</span>
							<a href={"https://wa.me/5492942404971?text=Hola!%20Quisiera%20consultar%20el%20precio%20del%20producto:%20" + producto.frontmatter?.title} class="boton-whatsapp">Consultar</a>
						</div>
					</div>
				</div>
			))}
		</div>

		{/* Sección de Piezas Terminadas */}
		<h2 class="subtitulo-catalogo">Piezas Terminadas</h2>
		<div class="grilla-productos">
			{catalogo.filter((producto: any) => producto.frontmatter?.categoria === 'Pieza Terminada').map((producto: any) => (
				<div class="tarjeta-producto">
					<div class="contenedor-imagen">
						<img src={producto.frontmatter?.image} alt={producto.frontmatter?.title} />
					</div>
					<div class="contenido-producto">
						<h3>{producto.frontmatter?.title}</h3>
						<p>{producto.frontmatter?.descripcion}</p>
						
						<div class="acciones-producto">
							<span class="etiqueta-stock">{producto.frontmatter?.stock}</span>
							<a href={"https://wa.me/5492942404971?text=Hola!%20Quisiera%20consultar%20el%20precio%20del%20producto:%20" + producto.frontmatter?.title} class="boton-whatsapp">Consultar</a>
						</div>
					</div>
				</div>
			))}
		</div>
	</main>
</Layout>

<style>
	.contenedor-catalogo {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem;
		font-family: Arial, sans-serif;
	}
	.titulo-catalogo {
		text-align: center;
		color: #5b4b8a; /* Tono morado para combinar con tus botones */
		font-size: 2.5rem;
		margin-bottom: 2rem;
	}
	.subtitulo-catalogo {
		color: #333;
		border-bottom: 2px solid #ddd;
		padding-bottom: 0.5rem;
		margin-bottom: 1.5rem;
		margin-top: 2.5rem;
	}
	.grilla-productos {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 2rem;
	}
	.tarjeta-producto {
		background: #ffffff;
		border-radius: 12px;
		box-shadow: 0 4px 15px rgba(0,0,0,0.08);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: transform 0.3s ease;
		border: 1px solid #eee;
	}
	.tarjeta-producto:hover {
		transform: translateY(-5px);
		box-shadow: 0 8px 25px rgba(0,0,0,0.12);
	}
	.contenedor-imagen {
		width: 100%;
		height: 250px; /* Esto hace que todas las fotos queden a la misma altura */
		background-color: #fcfcfc;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		box-sizing: border-box;
	}
	.contenedor-imagen img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain; /* Esta es la magia que achica la foto sin deformarla */
	}
	.contenido-producto {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}
	.contenido-producto h3 {
		margin: 0 0 0.5rem 0;
		font-size: 1.3rem;
		color: #222;
	}
	.contenido-producto p {
		font-size: 0.95rem;
		color: #555;
		margin-bottom: 1.5rem;
		line-height: 1.4;
		flex-grow: 1;
	}
	.acciones-producto {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-top: 1px solid #f0f0f0;
		padding-top: 1rem;
	}
	.etiqueta-stock {
		background: #e8f5e9;
		color: #2e7d32;
		padding: 0.4rem 0.8rem;
		border-radius: 20px;
		font-size: 0.85rem;
		font-weight: bold;
	}
</style>